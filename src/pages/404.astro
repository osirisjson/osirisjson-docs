---
import logo from '../assets/logo/osiris-logo-color-positive.svg';
import '../styles/osiris-theme.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Page not found - OSIRIS JSON</title>
		<meta http-equiv="refresh" content="0; url=/" />
		<link rel="icon" href="/favicon.svg" />
		<script>
			window.location.replace('/');
		</script>
	</head>
	<body class="osiris-404">
		<img src={logo.src} alt="OSIRIS JSON" />
		<p>Redirecting to <a href="/">the homepage</a>&hellip;</p>
	</body>
</html>
