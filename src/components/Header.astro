---
// Custom header replacing Starlight's default: logo (left), then a single
// right-hand cluster with Commitments/Resources dropdowns, Learn/Newsroom,
// GitHub, Search, and Try OSIRIS (Search sits between GitHub and Try OSIRIS).
import Search from 'virtual:starlight/components/Search';

import NavDropdown from './NavDropdown.astro';
import { navEntries } from '../config/nav';
import logo from '../assets/logo/osiris-logo-color-positive.svg';
import githubIconRaw from '../assets/icons/brand/github.svg?raw';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="osiris-header">
	<div class="title-wrapper sl-flex">
		<a href={siteTitleHref} class="site-title sl-flex">
			<img src={logo.src} width={logo.width} height={logo.height} alt="OSIRIS JSON" />
			<span class="sr-only">{siteTitle}</span>
		</a>
	</div>

	<div class="header-spacer" aria-hidden="true"></div>

	<div class="sl-flex print:hidden right-group">
		{
			navEntries.map((entry) =>
				entry.type === 'dropdown' ? (
					<NavDropdown
						label={entry.label}
						groups={entry.groups}
						align={entry.align}
						class="sl-hidden md:sl-flex"
					/>
				) : (
					<a href={entry.href} class="nav-link nav-underline sl-hidden md:sl-flex">
						{entry.label}
					</a>
				),
			)
		}
		<a
			href="https://github.com/osirisjson"
			target="_blank"
			rel="noreferrer"
			aria-label="GitHub"
			class="github-link sl-hidden md:sl-flex"
			set:html={githubIconRaw}
		/>
		<div class="search-wrapper">
			<Search />
		</div>
		<a href="osiris-producers/installation/" class="try-osiris-link sl-hidden md:sl-flex"
			>Download OSIRIS</a
		>
	</div>
</div>
