---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarGroup from './SidebarGroup.astro';
import SidebarLink from './SidebarLink.astro';
import { osirisSidebarSections } from './sidebar-data';

const currentPath = Astro.url.pathname;
---

{
	osirisSidebarSections.map((section) => (
		<div class="sidebar-section">
			<p class="sidebar-section-heading">{section.heading}</p>
			<ul class="top-level">
				{section.nodes.map((node) =>
					node.type === 'link' ? (
						<li>
							<SidebarLink
								link={node}
								isCurrent={
									(node.href.replace(/\/+$/, '') || '/') ===
									(currentPath.replace(/\/+$/, '') || '/')
								}
								large
							/>
						</li>
					) : (
						<SidebarGroup group={node} currentPath={currentPath} />
					),
				)}
			</ul>
		</div>
	))
}

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
